{
  "name": "theta",
  "version": "0.1.0",
  "description": "A desktop music studio for sketches that become songs.",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "node scripts/serve.mjs",
    "test": "node --test tests/model.test.mjs",
    "test:ui": "playwright test",
    "package": "electron-packager . Theta --platform=win32 --arch=x64 --out=release --overwrite --ignore=\"^/(tests|artifacts|.npm-cache|scripts)\""
  },
  "devDependencies": {
    "@electron/packager": "^18.4.4",
    "@playwright/test": "^1.63.0",
    "electron": "^41.7.1"
  }
}
